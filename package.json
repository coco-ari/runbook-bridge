{
  "name": "runbook-bridge",
  "version": "1.0.46",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "author": "AI Ops Tool contributors",
  "license": "MIT",
  "keywords": [
    "mcp",
    "codex",
    "ssh",
    "devops",
    "electron"
  ],
  "type": "module",
  "description": "A plugin-first local operations workbench for safe Agent access to servers, MySQL, and Redis",
  "homepage": "https://github.com/coco-ari/runbook-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coco-ari/runbook-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/coco-ari/runbook-bridge/issues"
  },
  "main": "src/main.mjs",
  "bin": {
    "ai-ops-mcp": "src/mcp-v2.mjs"
  },
  "scripts": {
    "start": "corepack pnpm run build:renderer && electron .",
    "install:electron-runtime": "node node_modules/electron/install.js",
    "test": "node --test test/*.test.mjs",
    "test:ui": "corepack pnpm run build:renderer && electron scripts/ui-react-foundation-smoke.cjs",
    "test:ui:business": "corepack pnpm run build:renderer && electron scripts/ui-react-business-smoke.cjs",
    "test:ui:plugins": "corepack pnpm run build:renderer && electron scripts/ui-react-plugin-operations-smoke.cjs",
    "test:ui:all": "corepack pnpm run test:ui && corepack pnpm run test:ui:business && corepack pnpm run test:ui:plugins && corepack pnpm run test:ui:plugin-matrix",
    "check:renderer": "tsc --project renderer/v2/tsconfig.json --noEmit",
    "build:renderer": "vite build --config renderer/v2/vite.config.ts",
    "test:ui:packaged": "node scripts/packaged-ui-smoke.cjs",
    "check": "node scripts/check-syntax.mjs && corepack pnpm run check:renderer",
    "dist": "corepack pnpm run build:renderer && electron-builder --win --publish never",
    "test:ui:plugin-matrix": "corepack pnpm run build:renderer && electron scripts/ui-react-plugin-editor-matrix-smoke.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "mysql2": "^3.23.3",
    "node-sql-parser": "^5.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "redis": "^6.2.1",
    "socks": "^2.8.7",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unzipper": "0.12.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.local.aiopstool",
    "productName": "Agent运维工作台",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/mcp.mjs",
      "renderer-build/v2/**/*",
      "!renderer/v2/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
